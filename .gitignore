# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but always commit the placeholder scaffold.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
tests/.auth/
test-results/
playwright-report/
playwright/.cache/

# Sentry Config File
.env.sentry-build-plugin

# OPD audit/scratch working data (not committed)
.scratch/

# Phase A PR1 dry-run sample renders (transient)
scripts/content/.dryrun-samples/
# Service Calendar one-time import intermediate (regeneratable via
# python3 scripts/_extract_sc_xlsx.py)
scripts/_sc_extract.json

# SC print artifacts - regenerated per PR via scripts/sc-print/gen-all-pdfs.mjs.
# Never commit; attach to PR body instead. Post-#421 cleanup. Widened
# 2026-07-14 to cover PNGs + nested subdirs + the -proto sibling.
scripts/sc-print/artifacts/
scripts/sc-print/artifacts-proto/

# kpi-2 real-budgets loader inputs. The seed JSON and the 11 P&L
# workbooks are Kevin's LOCAL client-financial files - never in the
# public repo, never in a commit, never in a PR. Belt-and-suspenders
# in case one is ever copied into the tree.
fy2026_pnl_budget_seed.json
*P_L*Clean.xlsx
*P&L*Clean.xlsx

# FIN-2027 loader baselines · per-cell budget+actual snapshots. Same
# reason as the workbooks above - real financial data in a public
# repo. Snapshots live outside the tree (~/Downloads/kf-fin2027-*).
# Belt-and-suspenders in case one is ever copied in.
*fin2027*baseline*snapshot*.json
*fin2027*local_reference*.json
scripts/probes/fin2027_w5_baseline_snapshot.json

# Probe artifacts default to gitignored. This repo is public; probe
# output routinely contains dollar figures, vendor names, and other
# per-charge detail. Only the minimal R-148B reversal record (source_
# line_id + reason, no dollars/vendors) is committable, as an exception.
# All other probe artifacts stay local. Full-detail review files live
# at ~/Downloads/kf-*-review.json instead.
scripts/probes/artifacts/*
!scripts/probes/artifacts/r148b_reversal.json
