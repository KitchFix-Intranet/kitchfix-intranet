#!/bin/sh
# Standing branch guard for multi-worktree, multi-agent scenarios.
#
# Refuses commits when the current branch does not match the expected
# branch. Expected branch is read from (in order):
#   1. $EXPECTED_BRANCH environment variable (session-set)
#   2. .git/branch-lock file (persistent-per-worktree, one line, plain text)
#
# Neither set -> hook is a no-op, commits proceed as normal.
#
# Motivation: a parallel commit on another terminal (or an IDE with
# branch-switching hooks) can flip the worktree branch between when you
# start editing and when you commit. Without a standing guard, your
# commit lands on whatever branch git reports at commit time, which may
# not be the branch you thought you were on.
#
# Enable per worktree:
#   git config core.hooksPath scripts/hooks
#
# Lock this worktree to a branch:
#   echo feat/whatever > .git/branch-lock
# Unlock:
#   rm .git/branch-lock

set -e

git_dir=$(git rev-parse --git-dir)
lock_file="$git_dir/branch-lock"
expected=""

if [ -n "${EXPECTED_BRANCH:-}" ]; then
  expected="$EXPECTED_BRANCH"
elif [ -f "$lock_file" ]; then
  expected=$(head -n 1 "$lock_file" | tr -d '[:space:]')
fi

if [ -z "$expected" ]; then
  exit 0
fi

actual=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")
if [ "$actual" != "$expected" ]; then
  echo "pre-commit: refusing to commit - branch mismatch"
  echo "  expected: $expected"
  echo "  actual:   $actual"
  echo ""
  echo "The branch guard (\$EXPECTED_BRANCH or $lock_file) is enforced."
  echo "Either switch to $expected or unlock: rm $lock_file"
  exit 1
fi

exit 0
