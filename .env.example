# KitchFix Intranet - local dev environment scaffold.
#
# Copy to .env.local and fill in real values from the Vercel dashboard:
#   https://vercel.com/ -> KitchFix-Intranet project -> Settings ->
#   Environment Variables. Every var below exists on the "Production"
#   environment; pull those values.
#
# Never commit .env.local. Never paste real secrets into this file.
#
# See docs/LOCAL_DEV.md for the full quickstart.


# =============================================================
# REQUIRED-TO-BOOT
# The dev server serves 200 on the root without these, but ANY
# request that touches auth fails immediately (the observed first
# failure at boot is `MissingSecret` from @auth/core). SC also
# calls Supabase unconditionally, so PG creds are effectively
# required for /service-calendar to load.
# =============================================================

# NextAuth v5 session-token signing secret. Auto-discovered by
# NextAuth from the env - not passed to the Auth() config directly.
# Missing = every auth() call throws MissingSecret. Pull from Vercel.
AUTH_SECRET=

# NextAuth v5 base URL. Local dev uses localhost:3000 exactly as
# below; NextAuth uses this for redirect callback URLs. Also read
# by /api/people email-link generators (fallback: localhost:3000).
AUTH_URL=http://localhost:3000

# Google OAuth client (single client shared prod + local). Both
# values pulled from Vercel. If the local redirect URI is not
# added to this client in Google Cloud Console, sign-in errors
# with `redirect_uri_mismatch` - see docs/LOCAL_DEV.md step 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account (Sheets / Drive / Gmail / Calendar).
# Same service account used in prod. The private key is a PEM
# with literal \n newlines - copy the exact string from Vercel;
# do not manually re-escape.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Supabase service-role connection. SC (and every other cut-over
# module) reads Postgres via getServiceClient() - missing values
# throw as soon as a data route is hit. The service-role key
# bypasses RLS - server-only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================
# REQUIRED-FOR-FEATURE
# Named surface fails without the value; the app boots + logs in.
# Copy the vars for the surfaces you actually want to exercise
# locally. Leaving them empty just means those integrations no-op.
# =============================================================

# --- Slack webhooks (each posts to a different channel) ---
# SC schedule-drift + related SC notifications
SLACK_SC_WEBHOOK_URL=
# Inventory due/overdue reminders (Ops)
SLACK_INVENTORY_WEBHOOK=
# Backup-sheets cron completion post
SLACK_RECAP_WEBHOOK=
# Playbook / OPD operations (falls back to SLACK_HELP_WEBHOOK)
SLACK_OPD_WEBHOOK=
# Help / general people-ops fallback channel
SLACK_HELP_WEBHOOK=
# New-hire onboarding notifications
SLACK_NEWHIRE_WEBHOOK=
# PAF (personnel action form) notifications
SLACK_PAF_WEBHOOK=
# Vendor management notifications
SLACK_VENDOR_WEBHOOK=
# Invoice submission / rejection / correction notifications
SLACK_INVOICE_WEBHOOK=
# Incident center notifications
SLACK_INCIDENT_WEBHOOK=
# Performance cycle notifications
SLACK_PERFORMANCE_WEBHOOK=

# --- Google Drive folder IDs (parent folders for uploads) ---
# Invoice uploads (invoice module)
GOOGLE_INVOICE_DRIVE_FOLDER_ID=
# News image uploads (news admin) - falls back to SA root if unset
NEWS_IMAGES_FOLDER_ID=
# Incident case folder root (incident center - unused in prod today)
INCIDENTS_DRIVE_ROOT_ID=
# Backup-sheets cron destination folder
BACKUP_FOLDER_ID=

# --- External services ---
# Anthropic Claude API - invoice OCR / photo-gate / line-item extract
ANTHROPIC_API_KEY=
# OpenAI - SousAI embeddings (prototype feature; only needed if
# actively iterating SousAI ingest)
OPENAI_API_KEY=
# GitHub token for playbook/OPD PR + issue operations
GITHUB_OPD_TOKEN=
# Railway WeasyPrint service (performance PDF renders)
WEASYPRINT_SERVICE_URL=
PERFORMANCE_RENDER_SECRET=
# Google Calendar ID for WoW plan 30/60/90 invites (defaults "primary")
PERFORMANCE_CALENDAR_ID=

# --- Cron gate (only needed if hitting /api/cron/* locally) ---
# Bearer token cron routes require. Local runs of cron routes are
# NOT recommended (they write to prod). Leave empty unless you know
# what you're doing.
CRON_SECRET=


# =============================================================
# CUTOVER CONTROL PLANE
# These flags gate Postgres reads/writes for the migrated modules.
# Prod carries specific values. LEAVE EMPTY LOCALLY unless you
# know you need to reproduce a specific cutover state - a wrong
# value here can cause dual-write side effects on production data.
# =============================================================
DUAL_WRITE_TABLES=
READ_FROM_POSTGRES=
# Per-module read overrides (only set what you specifically need):
# READ_FROM_POSTGRES_DIRECTORY=
# READ_FROM_POSTGRES_PEOPLE=
# READ_FROM_POSTGRES_VENDOR=
# READ_FROM_POSTGRES_INVOICE=
# READ_FROM_POSTGRES_NEWS=
# READ_FROM_POSTGRES_PLAYBOOK=


# =============================================================
# OPTIONAL-DEGRADES
# Guarded reads with sensible fallbacks. Set only if a specific
# surface's behavior needs the tuned value.
# =============================================================

# SC v2 theme flag preview default. "1" flips the .scv2 class on
# by default; a per-session ?v2=1 / ?v2=0 override still wins and
# persists in localStorage (see src/app/service-calendar/v2/flags.js).
NEXT_PUBLIC_SC_V2=

# Directory module admin allowlist (comma-separated emails).
# Empty = only the hardcoded SC_ADMIN list gets admin surfaces.
DIRECTORY_ADMIN_EMAILS=

# Invoice AP inbox email (fallback: k.fietek@kitchfix.com)
INVOICE_AP_EMAIL=

# People-ops cron "from" address (fallback: support@kitchfix.com)
PEOPLE_OPS_FROM_EMAIL=

# Incident calendar organizer email (fallback: m.chavez@kitchfix.com)
INCIDENT_CALENDAR_ORGANIZER=

# Playwright / e2e bypass. Double-gated on VERCEL != "1" in
# middleware, so setting this locally is safe; it is never
# effective in prod. Only set when running Playwright specs.
TEST_MODE=

# Client-side Sentry DSN (browser error reports). Leave empty
# locally unless you actively want to send local errors to
# Sentry (usually you don't).
NEXT_PUBLIC_SENTRY_DSN=
