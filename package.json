{
  "name": "kitchfix-intranet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:setup": "playwright test --project=setup",
    "test:unit": "node --import ./scripts/_setup/register-aliases.mjs --test 'scripts/content/__tests__/*.test.mjs'",
    "backfill:directory": "node --import ./scripts/_setup/register-aliases.mjs --env-file=.env.local scripts/backfill-directory.mjs",
    "backfill:submissions": "node --import ./scripts/_setup/register-aliases.mjs --env-file=.env.local scripts/backfill-submissions.mjs",
    "backfill:vendor": "node --import ./scripts/_setup/register-aliases.mjs --env-file=.env.local scripts/backfill-vendor.mjs",
    "backfill:invoice": "node --import ./scripts/_setup/register-aliases.mjs --env-file=.env.local scripts/backfill-invoice.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/mulish": "^5.2.8",
    "@kitchfix-intranet/shared": "^1.0.1",
    "@sentry/nextjs": "10.53.1",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "10.5.0",
    "googleapis": "171.4.0",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "^25.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.2.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "4.2.0"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
